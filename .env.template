# Artillegence AI — Environment Configuration
# Copy this to .env and fill in your keys.

# ── LLM PROVIDER (Required) ──
# Select your LLM backend: mistral, ollama, groq, gemini, nvidia
# mistral  — Mistral AI cloud (requires MISTRAL_API_KEY)
# ollama   — Local inference via Ollama (zero cost, zero rate limits)
# groq     — Groq cloud (requires GROQ_API_KEY, ultra-fast)
# gemini   — Google Gemini (requires GEMINI_API_KEY or GOOGLE_API_KEY)
# nvidia   — NVIDIA NIM (requires NVIDIA_API_KEY, OpenAI-compatible, works on 500MB server)
LLM_PROVIDER=nvidia

# ── CLOUD LLM KEYS (Required if using cloud providers) ──
MISTRAL_API_KEY=your_mistral_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here

# ── OLLAMA (Local) SETTINGS (Required if LLM_PROVIDER=ollama) ──
# Install Ollama from https://ollama.ai and run: ollama pull phi3:mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini

# ── NVIDIA SETTINGS (Required if LLM_PROVIDER=nvidia) ──
# Get API key at https://build.nvidia.com
# Base URL for OpenAI-compatible chat completions
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Recommended models for vision: z-ai/glm-5.2, meta/llama-3.2-90b-vision-instruct
NVIDIA_MODEL=z-ai/glm-5.2

# ── MODEL OVERRIDES (Optional) ──
# Override the model used for each provider
# MISTRAL_MODEL=mistral-large-latest
# GROQ_MODEL=llama-3.1-70b-versatile
# GEMINI_MODEL=gemini-2.0-flash
# VISION_MODEL=z-ai/glm-5.2  # Used by chart analysis agent

# ── SECURITY (Required) ──
# Any strong random string for JWT signing.
JWT_SECRET_KEY=your_jwt_secret_key_here

# ── OPTIONAL ──
# Webhook and DB paths are managed automatically on Render.
# NEWS_API_KEY, SERP_API_KEY, etc. are NO LONGER REQUIRED.